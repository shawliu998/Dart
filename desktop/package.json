{
  "name": "bidevidence-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "BidEvidence local Electron host",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && electron .",
    "dev": "npm run build && BIDEVIDENCE_DESKTOP_DEVTOOLS=1 electron ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "typescript": "^5.7.2"
  }
}
