# Local-only development defaults. Copy to .env and change passwords outside demos.
APP_ENV=development
APP_NAME=BidEvidence
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostgreSQL / pgvector
POSTGRES_DB=bidevidence
POSTGRES_USER=bidevidence
POSTGRES_PASSWORD=bidevidence-local-only
DATABASE_URL=postgresql+psycopg://bidevidence:bidevidence-local-only@postgres:5432/bidevidence
DATABASE_URL_SYNC=postgresql+psycopg://bidevidence:bidevidence-local-only@postgres:5432/bidevidence

# Redis jobs and progress
REDIS_URL=redis://redis:6379/0

# S3-compatible local storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-local-only
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-local-only
S3_BUCKET=bidevidence
S3_REGION=us-east-1
S3_USE_SSL=false

# Authentication: local demo values only; replace with generated secrets elsewhere.
AUTH_SECRET=development-only-change-me
# Legacy name retained only for adapters that have not migrated to AUTH_SECRET.
JWT_SECRET=development-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=demo1234
# Demo seed and compatibility identity headers are accepted only when APP_ENV=development.
# Every other environment requires a unique AUTH_SECRET/JWT_SECRET.

# Legacy Compose/demo names retained for delivery validation. Runtime provider selection uses
# the BIDEVIDENCE_LLM_* registry below. Never place a real key in committed files.
LLM_PROVIDER=mock
LLM_MODEL=mock-bidevidence-v1
LLM_PROMPT_VERSION=requirements-v2
OPENAI_API_KEY=
AI_MANUAL_REVIEW_THRESHOLD=0.70

# Requirement extraction uses these explicit provider-registry names. Keep mock for local/test/CI.
# Live evaluation additionally requires --allow-live; set the provider's current model identifier
# in BIDEVIDENCE_LLM_MODEL instead of relying on a hard-coded DeepSeek alias.
BIDEVIDENCE_LLM_PROVIDER=mock
BIDEVIDENCE_LLM_BASE_URL=
BIDEVIDENCE_LLM_API_KEY=
BIDEVIDENCE_LLM_MODEL=
BIDEVIDENCE_LLM_MAX_TOKENS=4096

# Optional offline OCR. auto uses local tesseract/pdftoppm when installed and never calls a network.
BIDEVIDENCE_OCR_MODE=auto
BIDEVIDENCE_OCR_LANGUAGES=chi_sim+eng

# Upload and worker safety limits
MAX_UPLOAD_BYTES=104857600
ZIP_MAX_EXPANDED_BYTES=524288000
ZIP_MAX_FILES=1000
WORKER_CONCURRENCY=2
# Disable this in the API process when a separate durable worker is deployed.
BIDEVIDENCE_LOCAL_WORKER_ENABLED=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
